dram: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000000

uart1: UART.NS16550 @ sysbus 0xf0300020
    wideRegisters: true
    ->plic@9

cpu0: CPU.RiscV32 @ sysbus
    cpuType: "rv32gc_xandes"
    hartId: 0
    timeProvider: empty
    privilegedArchitecture: PrivilegedArchitecture.Priv1_11

plic: IRQControllers.AndesNCEPLIC100 @ sysbus <0xe4000000, +0x2000000>
    numberOfContexts: 16
    prioritiesEnabled: true
    numberOfSources: 1023
    0->cpu0@11

mtimer: Timers.RiscVMachineTimer @ sysbus 0xe6000000
    frequency: 60000000
    ->cpu0@7

pcieStub: PCI.PcieStubRootPort @ sysbus 0x90000000

socStub: Memory.MappedMemory @ sysbus 0xe6400000
    size: 0x400000
