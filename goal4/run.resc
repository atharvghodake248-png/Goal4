include @D:/1_Project/goal4/peripherals/PcieGoal4.cs

emulation CreatePcieConnector "pcie"

# ---- machine "ep": second AE350 machine that hosts the Endpoint (its CPU stays halted) ----
mach create "ep"
machine LoadPlatformDescriptionFromString "using \"D:/1_Project/goal4/pcie_ep.repl\""
sysbus.cpu0 IsHalted true
logLevel -1 sysbus.pcieEp
connector Connect sysbus.pcieEp pcie

# ---- machine "rp": AE350 running the Zephyr firmware ----
mach create "rp"
machine LoadPlatformDescriptionFromString "using \"D:/1_Project/goal4/ae350_pcie_rp.repl\""
showAnalyzer sysbus.uart1
logLevel -1 sysbus.pcieRp
logLevel -1 sysbus.pcieBar
logLevel -1 sysbus.pcieMsi
connector Connect sysbus.pcieRp pcie
connector Connect sysbus.pcieBar pcie
connector Connect sysbus.pcieMsi pcie
sysbus LoadELF @D:/1_Project/goal4/fw/zephyr.elf
